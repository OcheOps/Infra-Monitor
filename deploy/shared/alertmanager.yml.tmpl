# Rendered by infra-monitor from your config. Double square brackets mark
# infra-monitor's substitutions; curly braces are Alertmanager's templating.
global:
  resolve_timeout: 5m
route:
  receiver: default
  group_by: ['alertname', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
receivers:
  - name: default
[[- with .Notifications.Telegram ]]
    telegram_configs:
      - bot_token: [[ q .BotToken ]]
        chat_id: [[ .ChatID ]]
        send_resolved: true
        message: |-
          {{ if eq .Status "firing" }}🔥 FIRING{{ else }}✅ RESOLVED{{ end }}: {{ .CommonLabels.alertname }}
          {{ range .Alerts }}• {{ .Annotations.summary }}
          {{ end }}
[[- end ]]
[[- with .Notifications.Slack ]]
    slack_configs:
      - api_url: [[ q .WebhookURL ]]
[[- with .Channel ]]
        channel: [[ q . ]]
[[- end ]]
        send_resolved: true
        title: '{{ if eq .Status "firing" }}FIRING{{ else }}RESOLVED{{ end }}: {{ .CommonLabels.alertname }}'
        text: '{{ range .Alerts }}• {{ .Annotations.summary }}{{ "\n" }}{{ end }}'
[[- end ]]
[[- with .Notifications.Email ]]
    email_configs:
      - to: [[ q .To ]]
        from: [[ q .From ]]
        smarthost: [[ q .Smarthost ]]
[[- with .Username ]]
        auth_username: [[ q . ]]
[[- end ]]
[[- with .Password ]]
        auth_password: [[ q . ]]
[[- end ]]
        send_resolved: true
[[- end ]]
[[- with .Notifications.Webhook ]]
    webhook_configs:
      - url: [[ q .URL ]]
        send_resolved: true
[[- end ]]
