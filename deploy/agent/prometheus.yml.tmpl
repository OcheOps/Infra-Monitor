# Prometheus in agent mode: scrapes this host and forwards everything to the
# server; it keeps only a short write-ahead log.
global:
  scrape_interval: 15s
  external_labels:
    agent: {{ q .Name }}
scrape_configs:
  - job_name: node
    static_configs:
      - targets: ['node-exporter:9100']
    relabel_configs:
      - target_label: instance
        replacement: {{ q .Name }}
  - job_name: cadvisor
    static_configs:
      - targets: ['cadvisor:8080']
    relabel_configs:
      - target_label: instance
        replacement: {{ q .Name }}
{{- range .Integrations }}
  - job_name: {{ q .Job }}
{{- with .Path }}
    metrics_path: {{ q . }}
{{- end }}
    static_configs:
      - targets: [{{ q .Address }}]
    relabel_configs:
      - target_label: instance
        replacement: {{ q (trimPrefix "integration-" .Job) }}
{{- end }}
remote_write:
  - url: {{ q .MetricsURL }}
    basic_auth:
      username: {{ q .Name }}
      password_file: /etc/infra-monitor/token
{{- if .CA }}
    tls_config:
      ca_file: /etc/infra-monitor/ca.crt
{{- end }}
